exports[`렌더 명령 (PRD 9.1) > fitMode 별 화면 맞춤 1`] = `"[in]scale=1920:1080:force_original_aspect_ratio=increase,crop=1920:1080[out]"`;

exports[`렌더 명령 (PRD 9.1) > fitMode 별 화면 맞춤 2`] = `"[in]scale=1920:1080:force_original_aspect_ratio=decrease:force_divisible_by=2,pad=1920:1080:(ow-iw)/2:(oh-ih)/2:color=black[out]"`;

exports[`렌더 명령 (PRD 9.1) > 기본: 구간 자르기 + 흐린 배경 + 고정 30fps + PCM 소리 (스냅샷) 1`] = `
[
  "-ss",
  "1.500000",
  "-t",
  "4.500000",
  "-i",
  "D:\\여행 영상\\IMG_0001.MOV",
  "-filter_complex",
  "[0:v]setpts=(PTS-STARTPTS)/1,fps=30,scale=w='trunc(iw*min(1,max(1920/iw,1080/ih))/2)*2':h=-2[in];[in]split[bg0][fg0];[bg0]scale=480:270:force_original_aspect_ratio=increase,crop=480:270,boxblur=5,scale=1920:1080[bg];[fg0]scale=1920:1080:force_original_aspect_ratio=decrease:force_divisible_by=2[fg];[bg][fg]overlay=(W-w)/2:(H-h)/2[out];[out]fps=30,setsar=1,format=yuv420p,tpad=stop_mode=clone:stop_duration=1,trim=end_frame=135[v];[0:a:0]asetpts=PTS-STARTPTS,aresample=48000,aformat=sample_fmts=s16:channel_layouts=stereo,apad,atrim=end_sample=216000[a]",
  "-map",
  "[v]",
  "-map",
  "[a]",
  "-c:v",
  "libx264",
  "-preset",
  "ultrafast",
  "-crf",
  "14",
  "-pix_fmt",
  "yuv420p",
  "-r",
  "30",
  "-colorspace",
  "bt709",
  "-color_primaries",
  "bt709",
  "-color_trc",
  "bt709",
  "-c:a",
  "pcm_s16le",
  "-ar",
  "48000",
  "-ac",
  "2",
  "-f",
  "mov",
  "D:\\cache\\clip_0000.mov",
]
`;

